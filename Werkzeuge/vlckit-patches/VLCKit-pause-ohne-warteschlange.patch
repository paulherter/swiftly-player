diff --git a/Sources/Playback/VLCMediaPlayer.m b/Sources/Playback/VLCMediaPlayer.m
index 1191390d..84103c31 100644
--- a/Sources/Playback/VLCMediaPlayer.m
+++ b/Sources/Playback/VLCMediaPlayer.m
@@ -1470,6 +1470,18 @@ - (void)stopTimeChangeUpdateTimer {
 
 - (void)play
 {
+    /* Swiftly: resuming from pause is a cheap, non-blocking libvlc call — it
+     * only restarts the clocks. Measured inside libvlc: 157-216 us for the
+     * whole pause path. Going through the serial queue for that costs 17-25 ms
+     * of latency, which is 2-3 frames at 120 Hz and clearly visible.
+     *
+     * The *first* play is different: it opens the media, which may hit the
+     * network. That one stays on the queue so the caller is never blocked. */
+    if (libvlc_media_player_get_state(_playerInstance) == libvlc_Paused) {
+        libvlc_media_player_set_pause(_playerInstance, 0);
+        return;
+    }
+
     dispatch_async(_libVLCBackgroundQueue, ^{
         libvlc_media_player_play(_playerInstance);
     });
@@ -1477,10 +1489,14 @@ - (void)play
 
 - (void)pause
 {
-    // Pause the stream
-    dispatch_async(_libVLCBackgroundQueue, ^{
-        libvlc_media_player_set_pause(_playerInstance, 1);
-    });
+    /* Swiftly: called directly, not via the serial queue.
+     *
+     * libvlc_media_player_set_pause() takes the player lock and pushes a
+     * control onto the input thread; measured end to end inside libvlc it is
+     * 157-216 us, so there is nothing here worth deferring. The dispatch was
+     * costing 17-25 ms before libvlc even saw the command — the pause the user
+     * sees lagged the button by 2-3 frames because of it. */
+    libvlc_media_player_set_pause(_playerInstance, 1);
 }
 
 - (void)stop
