<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".SwiftlyAnwendung"
        android:label="Swiftly"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/netz_vertrauen"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- configChanges wie beim Player: eine Drehung baut die Aktivitaet nicht neu. Compose
             richtet sich selbst neu aus; ein Neubau warf dagegen den Seitenstapel weg (er steht in
             `remember`) und liess `LaunchedEffect(spiel)` ein zweites Mal laufen — beim Schliessen
             des Players ging die Folge dann wieder auf. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- In der Aufgabe der App: der Player liegt oben drauf und blendet beim Schliessen aus.
             Fuer das kleine Fenster loest Android ihn von selbst in eine eigene Aufgabe. -->
        <activity
            android:name=".PlayerAktivitaet"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden" />
        <!-- Fernseher: eigener Einstieg ueber den Leanback-Starter, dieselbe App darunter.
             singleTask: ein Tipp auf einen Watch-Next-Eintrag (siehe TvWeiterschauenRegal.kt)
             soll in die schon laufende Aktivitaet gehen (onNewIntent), nicht eine zweite
             daneben oeffnen — sonst haette die App zwei eigene Seitenstapel gleichzeitig. -->
        <activity
            android:name=".tv.TvAktivitaet"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Watch Next fuehrt ueber diesen Link zurueck in die App — dieselbe Adresse wie
                 "swiftly://titel/<id>" im Top Shelf auf tvOS (`RegalAnbieter.swift`). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="swiftly" android:host="titel" />
            </intent-filter>
        </activity>
        <service
            android:name=".WiedergabeDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".DownloadDienst"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- „Protokoll teilen": gibt genau die eine Datei an das Teilen-Blatt (`Protokolldatei`). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.protokoll"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/protokoll_pfade" />
        </provider>
    </application>
</manifest>
