<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".SwiftlyAnwendung"
        android:label="Swiftly"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- In der Aufgabe der App: der Player liegt oben drauf und faehrt beim Schliessen hinunter.
             Fuer das kleine Fenster loest Android ihn von selbst in eine eigene Aufgabe. -->
        <activity
            android:name=".PlayerAktivitaet"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden" />
        <!-- Fernseher: eigener Einstieg ueber den Leanback-Starter, dieselbe App darunter. -->
        <activity
            android:name=".tv.TvAktivitaet"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".WiedergabeDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".DownloadDienst"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
