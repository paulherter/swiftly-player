<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- `launch_background` (tokens_launch.xml, generated from `surface.base`) is the window background: between
         launch and first frame the Theme.Material gray showed, then it jumped to the app. -->
    <style name="Swiftly" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
    </style>
</resources>
