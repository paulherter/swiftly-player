<?xml version="1.0" encoding="utf-8"?>
<!-- Background layer of the app icon: the **brand surface** #17181B, not the app background
     #101010. Same combination as `Marken.markeFlaeche` in Sources/Shared/Marks.swift, used by the
     icon on iOS, iPadOS, tvOS and macOS.

     Fully opaque and without rounding: for an adaptive icon the system mask cuts the corners, so
     a radius of its own would give a double edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#17181B" android:pathData="M0,0h108v108h-108z" />
</vector>
