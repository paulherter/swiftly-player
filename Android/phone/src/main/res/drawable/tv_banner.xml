<?xml version="1.0" encoding="utf-8"?>
<!--
    Banner for the TV launcher, 320 x 180.
    
    Brand surface #17181B, not the app background #101010: same pair as the app icon and Apple
    (`Marken.markeFlaeche` / `markeAkzent`). The banner is a brand tile, not a page; two different
    dark tones for the same role would only add a difference.
    
    The mark is the brand path (`Marken.signetForm`), so icon, banner and launch curtain show the
    same shape. The path lives in its own 1024 box; it is scaled to 124 and centred, which makes
    the mark 56 high, about a third of the banner height, as on tvOS.
    
        scale    124 / 1024 = 0.12109375
        offset   x (320 - 124) / 2 = 98      y (180 - 124) / 2 = 28
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp"
    android:viewportWidth="320" android:viewportHeight="180">
    <path android:fillColor="#17181B" android:pathData="M0,0h320v180h-320z" />
    <group android:scaleX="0.12109375" android:scaleY="0.12109375"
           android:translateX="98" android:translateY="28">
        <path android:fillColor="#50D5DA"
              android:pathData="M440.1,280l285,163.2c38,21.7,51.2,70,29.6,108-7,12.3-17.2,22.5-29.6,29.6l-285,163.2c-37.9,21.8-86.3,8.6-108.1-29.3-6.9-12-10.5-25.6-10.5-39.4v-326.6c0-43.7,35.5-79.2,79.2-79.2,13.8,0,27.4,3.6,39.4,10.5Z" />
    </group>
</vector>
