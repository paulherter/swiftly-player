<?xml version="1.0" encoding="utf-8"?>
<!-- Same two layers as `ic_launcher`: the launcher picks the mask itself, and the safe zone is
already accounted for the round one (see `ic_launcher_vordergrund`). A separate round
version would be a second source of truth. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
