    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiftly sucht deinen Jellyfin-Server im heimischen Netz. Ohne diese Erlaubnis findet die App einen Server unter einer Adresse wie 192.168.1.5 nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiftly looks for your Jellyfin server on your home network. Without this, the app cannot reach a server at an address like 192.168.1.5."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiftly ищет ваш сервер Jellyfin в домашней сети. Без этого разрешения приложение не найдёт сервер по адресу вроде 192.168.1.5."
          }
        }
      }
    }
  },
  "version": "1.0"
