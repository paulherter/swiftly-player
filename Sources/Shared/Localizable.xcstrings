    "Für einen Dienst vor deinem Server, etwa Cloudflare Access, Authelia oder Pangolin. Swiftly schickt die Header nur an diese Adresse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Dienst vor deinem Server, etwa Cloudflare Access, Authelia oder Pangolin. Swiftly schickt die Header nur an diese Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a service in front of your server, like Cloudflare Access, Authelia or Pangolin. Swiftly only sends these headers to this address."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сервиса перед вашим сервером, например Cloudflare Access, Authelia или Pangolin. Swiftly отправляет эти заголовки только на этот адрес."
          }
        }
      }
    },
