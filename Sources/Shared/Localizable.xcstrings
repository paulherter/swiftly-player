    "Läuft bis zum %@. Danach verlängert sich nichts, deine Extras gehen zurück auf Standard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft bis zum %@. Danach verlängert sich nichts, deine Extras gehen zurück auf Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs until %@. Nothing renews after that, and your extras go back to standard."
