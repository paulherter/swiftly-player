    "Formatfüllend schneidet links und rechts ab, damit keine Balken bleiben. Geht auch mit zwei Fingern im Bild.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatfüllend schneidet links und rechts ab, damit keine Balken bleiben. Geht auch mit zwei Fingern im Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill screen crops the left and right edges so no bars remain. Pinch on the video to switch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Растянуть» обрезает края слева и справа, чтобы не было полос. Можно переключить и щипком двумя пальцами по видео."
          }
        }
      }
    },
