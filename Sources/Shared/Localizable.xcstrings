          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server asks for two-factor confirmation. Approve this device in your browser or sign in with an app password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер требует двухфакторное подтверждение. Разрешите это устройство в браузере или войдите с паролем приложения."
          }
        }
      }
    },
    "Deine Anfrage ist durch. Der Titel erscheint von selbst in deiner Bibliothek.": {
