    "Auf jeder Film- und Serienseite gibt es ein Feld zum Laden. Geladene Titel laufen auch ohne Netz — in voller Qualität, weil Swiftly nie umrechnet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Film- und Serienseite gibt es ein Feld zum Laden. Geladene Titel laufen auch ohne Netz — in voller Qualität, weil Swiftly nie umrechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every movie and show page has a button to download. Downloaded titles play without a connection — in full quality, because Swiftly never re-encodes."
          }
        }
      }
    },
