    "Jede Funktion bleibt kostenlos, für alle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Funktion bleibt kostenlos, für alle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every feature stays free, for everyone."
          }
