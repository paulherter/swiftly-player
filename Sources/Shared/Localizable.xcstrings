    "Auf deinem Server gibt es sonst nichts mit %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Server gibt es sonst nichts mit %@."
