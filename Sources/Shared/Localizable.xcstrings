          "stringUnit": {
            "state": "translated",
            "value": "There is nothing else with %@ on your server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше ничего с участием %@ на вашем сервере нет."
          }
        }
      }
    },
    "Auf deinem Server steht dazu nichts. Manchmal ist es nur ein Buchstabe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Server steht dazu nichts. Manchmal ist es nur ein Buchstabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on your server for that. Sometimes it's just one letter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем сервере ничего не нашлось. Иногда дело в одной букве."
          }
        }
      }
    },
    "Auf dem Gerät": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät"
          }
        },
