        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все функции остаются бесплатными для всех."
          }
        }
      }
    },
    "Keine Werbung, kein Tracking, kein Konto bei uns. Swiftly entsteht offen, und wer es mag, legt etwas dazu, damit es weiterwachsen kann.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung, kein Tracking, kein Konto bei uns. Swiftly entsteht offen, und wer es mag, legt etwas dazu, damit es weiterwachsen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no tracking, no account with us. Swiftly is built in the open, and the people who enjoy it chip in so it can keep growing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без рекламы, без слежки, без учётной записи у нас. Swiftly создаётся открыто, и те, кому он нравится, вносят свой вклад, чтобы он рос дальше."
          }
        }
      }
    },
