    "%@ antwortet nicht. Läuft er noch, oder hängt das WLAN?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet nicht. Läuft er noch, oder hängt das WLAN?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t answering. Is it still running, or is the Wi-Fi stuck?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не отвечает. Он ещё работает, или завис Wi-Fi?"
          }
        }
      }
    },
    "%@ hat nicht geantwortet. Läuft der Server, und bist du im selben Netz?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht geantwortet. Läuft der Server, und bist du im selben Netz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer. Is the server running, and are you on the same network?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не ответил. Сервер запущен, и вы в той же сети?"
          }
        }
      }
    },
