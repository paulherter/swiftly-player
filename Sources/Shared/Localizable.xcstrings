    "Gilt für jeden Film und jede Folge, die du startest. Im Player kannst du es für den laufenden Titel ändern.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jeden Film und jede Folge, die du startest. Im Player kannst du es für den laufenden Titel ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every film and episode you start. In the player you can change it for what’s playing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует для каждого фильма и эпизода, которые вы запускаете. В плеере это можно изменить для текущего тайтла."
          }
        }
