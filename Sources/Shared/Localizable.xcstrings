    "Wir bauen Swiftly ohne Werbung und ohne Tracking. Wenn es deine Abende besser macht, hilft uns ein Kaffee, weiterzumachen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bauen Swiftly ohne Werbung und ohne Tracking. Wenn es deine Abende besser macht, hilft uns ein Kaffee, weiterzumachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We build Swiftly without ads or tracking. If it makes your evenings better, a coffee helps us keep going."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы делаем Swiftly без рекламы и слежки. Если с ним ваши вечера стали лучше, чашка кофе поможет нам продолжать."
          }
        }
      }
    },
