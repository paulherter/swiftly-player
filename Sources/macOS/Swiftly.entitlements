<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Der Mac App Store verlangt die Sandbox zwingend. Ohne sie wird die
	     App beim Hochladen abgewiesen, nicht erst bei der Pruefung. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Und ohne das erreicht sie in der Sandbox keinen Jellyfin mehr:
	     ausgehende Verbindungen sind darin standardmaessig gesperrt. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- **Lauschen, nur auf 127.0.0.1.** Hinter einem Vorposten (Cloudflare
	     Access, Authelia …) braucht der Strom eigene Header, die VLC nicht
	     senden kann. Der Stromweiterleiter im Paket nimmt VLCs Anfrage auf
	     127.0.0.1 an und holt den Strom mit den Headern — nur wenn welche
	     eingetragen sind. Ohne dieses Recht verweigert die Sandbox das bind.
	     Am 03.09.2026 wurde ein Bau abgewiesen, weil das Recht ohne Code
	     dastand, der es braucht; jetzt gibt es ihn (Stromweiterleiter.swift). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Dieselbe Begruendung wie auf iOS: ohne die Zugriffsgruppe verweigert
	     der Keychain das Schreiben (-34018) und die Anmeldung ginge bei
	     jedem Start verloren. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.paulherter.swiftly</string>
	</array>
</dict>
</plist>
