#
# Fuer Arch, CachyOS, Manjaro, EndeavourOS. Bauen und installieren:
#
# makepkg -si
#
# Swift liegt nicht in den offiziellen Quellen. `swift-bin` aus dem AUR ist der
# uebliche Weg; wer die Toolchain schon ueber swiftly unter $HOME hat, setzt
# einfach SWIFT=/pfad/zu/swift und makepkg nimmt die.

pkgname=swiftly-jellyfin
pkgver=1.0.4
pkgrel=3
pkgdesc="Jellyfin-Client, der niemals transkodiert"
arch=('x86_64' 'aarch64')
# **Der heutige Name, und das ist kein Schoenheitsfehler.** Unter
# `swiftly-for-jellyfin` liegt ein **eigenes, weiterlebendes** Repository —
# GitHub leitet nicht um: `git ls-remote` gibt dort `main` auf einem anderen
# Stand und kennt `windows` gar nicht. `source=` haette also einen fremden
# Baum geholt und `makepkg -si` daraus gebaut. Der alte Ort traegt nur noch
# die `gh-pages` mit der alten Paketquelle am Leben; wie man umzieht, steht
# in der README.
url="https://github.com/paulherter/swiftly-player"
license=('MPL-2.0')
depends=('gtk4' 'vlc' 'glibc' 'gcc-libs')
makedepends=('git' 'gcc' 'pkgconf' 'swift-bin')
source=("git+$url.git#branch=main"
        "git+https://github.com/Samsung/rlottie.git")
sha256sums=('SKIP' 'SKIP')

_swift() { echo "${SWIFT:-swift}"; }

build() {
    # rlottie kommt statisch mit ins Programm — es gibt sie in keinem Repo,
    # und eine mitgelieferte .so waere genau die Sorte Abhaengigkeit, die auf
    # fremden Rechnern nicht gefunden wird.
    export SWIFTLY_RLOTTIE_ZIEL="$srcdir/rlottie-praefix"
    bash "$srcdir/swiftly-player/Werkzeuge/rlottie-bauen.sh" "$srcdir/rlottie"

    export PKG_CONFIG_PATH="$SWIFTLY_RLOTTIE_ZIEL/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    cd "$srcdir/swiftly-player/Linux"
    "$(_swift)" build -c release -Xswiftc -static-stdlib
    # Wohin gebaut wurde, sagt derselbe Aufruf — `.build/release` ist nur ein
    # Verweis, den SwiftPM umhaengen darf.
    "$(_swift)" build -c release -Xswiftc -static-stdlib --show-bin-path \
        > "$srcdir/bauordner.txt"
}

package() {
    local q="$srcdir/swiftly-player"
    local b
    b="$(cat "$srcdir/bauordner.txt")"
    [ -d "$b" ] || { echo "Kein Bauordner: $b" >&2; return 1; }

    # Programm und Ressourcenbuendel bleiben beisammen: Swift findet
    # `Bundle.module` ueber den Pfad der laufenden Datei.
    install -Dm755 "$b/SwiftlyLinux" "$pkgdir/usr/lib/$pkgname/$pkgname"

    # **Beide Namen.** Bis Swift 6.3 heisst ein Buendel `<Ziel>_<Ziel>.resources`,
    # ab 6.4 `<Ziel>_<Ziel>.bundle`; der erzeugte `Bundle.module`-Zugriff sucht
    # genau den, unter dem gebaut wurde. Hier stand nur `.resources`, und auf
    # 6.4 baute das Paket klaglos eines ohne jedes Buendel — die 1.0.3 starb
    # beim Start an „unable to find bundle named SwiftlyLinux_SwiftlyLinux".
    local n=0 buendel z
    for buendel in "$b"/*.resources "$b"/*.bundle; do
        [ -d "$buendel" ] || continue
        cp -r "$buendel" "$pkgdir/usr/lib/$pkgname/"
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || { echo "Kein Ressourcenbuendel in $b" >&2; return 1; }
    # JellyfinKits Buendel traegt `de.lproj` und `en.lproj`; ohne es stirbt die
    # App eine Ebene spaeter in `Textkatalog.bundle(bundle:sprache:)`.
    for z in SwiftlyLinux JellyfinKit; do
        [ -d "$pkgdir/usr/lib/$pkgname/${z}_${z}.resources" ] ||
        [ -d "$pkgdir/usr/lib/$pkgname/${z}_${z}.bundle" ] ||
            { echo "Ressourcenbuendel fehlt: ${z}_${z}" >&2; return 1; }
    done
    cp -r "$q/Linux/Ressourcen" "$pkgdir/usr/lib/$pkgname/Ressourcen"
    install -d "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

    install -Dm644 "$q/Linux/Installieren/de.paulherter.swiftly.desktop" \
        "$pkgdir/usr/share/applications/de.paulherter.swiftly.desktop"
    install -Dm644 "$q/Linux/Installieren/de.paulherter.swiftly.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/de.paulherter.swiftly.metainfo.xml"

    for grad in 32 64 128 256 512; do
        install -Dm644 \
            "$q/Linux/Ressourcen/icons/hicolor/${grad}x${grad}/apps/de.paulherter.swiftly.png" \
            "$pkgdir/usr/share/icons/hicolor/${grad}x${grad}/apps/de.paulherter.swiftly.png"
    done

    install -Dm644 "$q/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
