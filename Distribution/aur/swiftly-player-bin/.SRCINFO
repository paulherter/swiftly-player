pkgbase = swiftly-player-bin
	pkgdesc = Jellyfin client that never transcodes (prebuilt binary)
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/paulherter/swiftly-player
	arch = x86_64
	license = MPL-2.0
	options = !strip
	options = !debug
	depends = glibc
	depends = gcc-libs
	depends = mpv
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = freetype2
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = ca-certificates
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: Vulkan driver for NVIDIA GPUs
	optdepends = vulkan-swrast: software Vulkan fallback
	provides = swiftly-jellyfin
	provides = swiftly-player
	conflicts = swiftly-jellyfin
	source = https://github.com/paulherter/swiftly-player/releases/download/v1.1.0/swiftly-player-1.1.0-linux-x64.tar.gz
	source = LICENSE-1.1.0::https://raw.githubusercontent.com/paulherter/swiftly-player/v1.1.0/LICENSE
	source = THIRD-PARTY-NOTICES-1.1.0.md::https://raw.githubusercontent.com/paulherter/swiftly-player/v1.1.0/THIRD-PARTY-NOTICES.md
	sha256sums = SKIP
